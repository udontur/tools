---
let buildNumber = "NOT_PRODUCTION"
let envBuildNumber = import.meta.env.PUBLIC_VERCEL_GIT_COMMIT_SHA
// if (import.meta.env.PROD) {
//   buildNumber = envBuildNumber.slice(0, 7)
// }
---

<div class="flex justify-center">
  <div
    class="mt-12 mb-12 text-xs text-muted-foreground/65 cursor-default hover:text-muted-foreground ease-in-out duration-200"
  >
    Build
    <a
      class="text-inherit underline decoration-solid"
      href={"https://github.com/udontur/school-linktree/tree/"+envBuildNumber}
    >
      {buildNumber}
    </a>
    made with passion by
    <a href="https://hadrian.cc">Hadrian</a>
  </div>
</div>
