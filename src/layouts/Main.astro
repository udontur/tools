---
import ToolCard from "@/components/ToolCard.astro";
import tools from "@/data/tools.json";
---
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mx-auto max-w-300 px-4">
  {tools.map((tool) => (
    <ToolCard
      imageName="hockey.jpg"
      name={tool.name}
      description={tool.description}
      whenMade={tool.whenMade}
      url={tool.url}
    />
  ))}
</div>
