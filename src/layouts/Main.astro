---
import ToolCard from "@/components/ToolCard.astro";
import tools from "@/data/tools.json";
---
  <div class="flex flex-wrap justify-center gap-6 mx-auto max-w-300 px-4">
  {tools.map((tool) => (
    <ToolCard
      imageName={tool.imageName}
      name={tool.name}
      description={tool.description}
      whenMade={tool.whenMade}
      url={tool.url}
    />
  ))}
</div>
