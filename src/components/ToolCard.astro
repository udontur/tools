---
import {
  Card,
  CardContent,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";

import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";


interface Props {
  imageName: string;
  name: string;
  description: string;
  whenMade: string;
  url: string;
}
const {imageName, name, description, whenMade, url} = Astro.props;
const imagePath = "/src/assets/image/" + imageName;
const images = import.meta.glob<{default: ImageMetadata}>(
  "/src/assets/image/*.{jpg,jpeg,png}"
);

---
<a href={url}>
  <Card className="w-full max-w-87">
    <CardHeader>
      <Image
        class="rounded-xs mb-3"
        src={images[imagePath]()}
        alt="Desc"
        width={300}
      />
      <div>
        <CardTitle>
          {name}
        </CardTitle>
        <CardDescription>
          {description}
        </CardDescription>
      </div>
    </CardHeader>
    <CardContent>
      <Badge variant="outline">{whenMade}</Badge>
    </CardContent>
  </Card>
</a>
