---
import {
  Card,
  CardAction,
  CardContent,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  imageName: string;
}
const {imageName} = Astro.props;
const imagePath = "/src/assets/image/" + imageName;
const images = import.meta.glob<{default: ImageMetadata}>(
  "/src/assets/image/*.{jpg,jpeg,png}"
);

---

<Card>
  <Image src={images[imagePath]()} alt="Desc"/>
</Card>
